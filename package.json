{
  "name": "dsh-promptkit",
  "version": "0.2.1",
  "description": "开源的 Prompt 构建与增强工具包：方法工坊（Studio）+ 对话快捷增强器（QuickEnhancer）。内置 21 个 Markdown 思考方法（含技术开发/数据分析等场景卡 + frontmatter + prompt 正文），可作为 npm 库嵌入，也可直接安装为 DSH 浏览器插件。",
  "type": "module",
  "main": "src/index.js",
  "module": "src/browser.js",
  "exports": {
    ".": { "browser": "./src/browser.js", "default": "./src/index.js" },
    "./browser": "./src/browser.js",
    "./client": "./ui/client.js",
    "./client-lite": "./ui/client-lite.js",
    "./ui": "./ui/plugin.js",
    "./ui/client": "./ui/client.js",
    "./ui/package.json": "./ui/package.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "ui",
    "dsh",
    "cordis.patch.yml",
    "scripts",
    "docs",
    "examples",
    "methods",
    "test",
    "README.md",
    "README.zh.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "cuijiaqi <cjqzazj@gmail.com>",
  "homepage": "https://github.com/fsrmqi/dsh-promptkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/fsrmqi/dsh-promptkit.git"
  },
  "bugs": {
    "url": "https://github.com/fsrmqi/dsh-promptkit/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "prompt",
    "prompt-engineering",
    "llm",
    "ui",
    "react"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "build:ui": "node scripts/build-client.mjs",
    "build:ui:lite": "node scripts/build-client.mjs --lite",
    "build": "npm run check && npm run build:methods && npm run build:ui && npm run build:ui:lite",
    "build:methods": "node scripts/build-methods.mjs",
    "build:embed": "node scripts/build-client.mjs --embed",
    "test": "node --test",
    "test:dsh-smoke": "node scripts/dsh-profile-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "katex": "0.16.22",
    "react-dom": "^19.2.8"
  }
}
